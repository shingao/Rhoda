{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bullshit",
  "version": "1.0.0",
  "identifier": "com.bullshit.notes",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Bullshit",
        "width": 1280,
        "height": 820,
        "minWidth": 860,
        "minHeight": 520,
        "center": true,
        "decorations": false,
        "visible": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: vault: http://vault.localhost; connect-src 'self' ipc: http://ipc.localhost vault: http://vault.localhost",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Bullshit",
    "copyright": "© 2026",
    "shortDescription": "Notes locales en Markdown",
    "longDescription": "Bullshit : prise de notes locale en Markdown pour Windows.",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French"
        ],
        "displayLanguageSelector": false,
        "customLanguageFiles": {
          "French": "installer/French.nsh"
        },
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
